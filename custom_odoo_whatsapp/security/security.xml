<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Odoo 19.4 (saas~19.4) removeu `ir.model.access` e `ir.rule`: os dois foram
    fundidos no model unico `ir.access` (odoo/addons/base/models/ir_access.py).
    Os quatro booleanos perm_create/read/write/unlink viraram o campo `operation`,
    uma selection com o subconjunto de "crud" ('crud' = acesso total).
    O campo opcional `domain` cobre o que antes era `ir.rule`.
  -->
  <record id="ir_access_zap_messages" model="ir.access">
    <field name="name">zap_message</field>
    <field name="model_id" ref="custom_odoo_whatsapp.model_custom_zap_messages" />
    <field name="group_id" ref="sales_team.group_sale_salesman" />
    <field name="operation">crud</field>
  </record>
</odoo>
