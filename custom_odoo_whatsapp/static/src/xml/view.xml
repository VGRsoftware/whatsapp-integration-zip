<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <!--
    Odoo 19.4 (saas~19.4) usa OWL 3 via camada de compatibilidade:
      * expressoes de template exigem prefixo `this.`
      * `t-ref` com nome em string virou `t-custom-ref`
      * a prop `record` do chatter fica em `this.webChatterProps`, nao em `props`
    Nao colocamos ref nas divs nativas (o-mail-Chatter-top/-content) porque a
    o-mail-Chatter-top ja possui `t-custom-ref="top"` usado pelo core; sobrescrever
    quebraria o chatter. O JS localiza as divs a partir do proprio painel.
  -->
  <t t-inherit="mail.Chatter" t-inherit-mode="extension">

    <xpath expr="//div[hasclass('o-mail-Chatter-top')]" position="before">
      <t t-if="this.webChatterProps.record and (this.webChatterProps.record.resModel === 'crm.lead' or this.webChatterProps.record.resModel === 'sale.order')">
        <div class="o-chatter-zap-toggle d-flex mx-2 mt-2">

          <button t-custom-ref="chatterBtn"
            class="btn flex-fill btn-secondary o_zap_btn_chatter"
            t-on-click="() => this.zapToggle('chatter')"
          >Chatter</button>
          <button t-custom-ref="zapBtn"
            class="btn flex-fill btn-primary o_zap_btn_iframe"
            t-on-click="() => this.zapToggle('zap')"
          >WhatsApp</button>
        </div>

        <div t-custom-ref="zap" class="o-chatter-zap-panel hidden px-2 pb-2 mt-2"
          style="width:100%; height:100%; min-height: 500px; overflow:hidden;">
          <iframe t-att-src="this.webChatterProps.record.data.x_iframe"
            style="width:100%; min-height: 600px; height:100%; border-radius:6px; border: #262A36 solid 1px" />
        </div>
      </t>
    </xpath>

  </t>

</templates>
