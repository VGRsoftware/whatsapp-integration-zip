<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================ x_whatsapp_template ============================ -->

  <record id="view_whatsapp_template_list" model="ir.ui.view">
    <field name="name">x.whatsapp.template.list</field>
    <field name="model">x_whatsapp_template</field>
    <field name="arch" type="xml">
      <list string="Templates">
        <field name="x_name" />
      </list>
    </field>
  </record>

  <record id="view_whatsapp_template_form" model="ir.ui.view">
    <field name="name">x.whatsapp.template.form</field>
    <field name="model">x_whatsapp_template</field>
    <field name="arch" type="xml">
      <form string="Template">
        <sheet>
          <group>
            <field name="x_name" placeholder="Nome do template" />
          </group>
          <group string="Mensagem">
            <field name="x_body" widget="html" nolabel="1" colspan="2" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_whatsapp_template" model="ir.actions.act_window">
    <field name="name">Templates</field>
    <field name="res_model">x_whatsapp_template</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ============================ x_whatsapp_campaing ============================ -->

  <record id="view_whatsapp_campaing_list" model="ir.ui.view">
    <field name="name">x.whatsapp.campaing.list</field>
    <field name="model">x_whatsapp_campaing</field>
    <field name="arch" type="xml">
      <list string="Campanhas">
        <field name="x_name" />
        <field name="x_template_id" />
        <field name="x_number" />
        <field name="x_status" widget="badge" decoration-success="x_status == 'sent'" decoration-danger="x_status == 'error'" decoration-info="x_status == 'processing'" decoration-muted="x_status == 'pending'" />
        <field name="x_send_date" />
      </list>
    </field>
  </record>

  <record id="view_whatsapp_campaing_form" model="ir.ui.view">
    <field name="name">x.whatsapp.campaing.form</field>
    <field name="model">x_whatsapp_campaing</field>
    <field name="arch" type="xml">
      <form string="Campanha">
        <sheet>
          <group>
            <group>
              <field name="x_name" placeholder="Nome da campanha" />
              <field name="x_template_id" />
            </group>
            <group>
              <field name="x_number" placeholder="Numero remetente" />
              <field name="x_send_date" />
              <field name="x_status" />
            </group>
          </group>
          <group string="Destinatarios">
            <field name="x_partner_ids" widget="many2many_tags" nolabel="1" colspan="2" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_whatsapp_campaing" model="ir.actions.act_window">
    <field name="name">Campanhas</field>
    <field name="res_model">x_whatsapp_campaing</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ============================ ir.actions.server ============================ -->

  <record id="view_server_action_form_whatsapp" model="ir.ui.view">
    <field name="name">ir.actions.server.form.whatsapp.template</field>
    <field name="model">ir.actions.server</field>
    <field name="inherit_id" ref="base.view_server_action_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='model_id']" position="after">
        <field name="x_whatsapp_template_id" options="{'no_create': True}" />
      </xpath>
    </field>
  </record>

  <!-- ============================ menus ============================ -->

  <menuitem id="menu_whatsapp_mass_root"
            name="Campanhas Whatsapp"
            web_icon="custom_odoo_whatsapp_mass,static/description/icon.png"
            groups="sales_team.group_sale_salesman"
            sequence="90" />

  <menuitem id="menu_whatsapp_campaing"
            name="Campanhas"
            parent="menu_whatsapp_mass_root"
            action="action_whatsapp_campaing"
            sequence="10" />

  <menuitem id="menu_whatsapp_template"
            name="Templates"
            parent="menu_whatsapp_mass_root"
            action="action_whatsapp_template"
            sequence="20" />

</odoo>
