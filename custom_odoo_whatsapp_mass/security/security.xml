<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Odoo 19.4 (saas~19.4) removeu `ir.model.access` e `ir.rule`: os dois foram
    fundidos no model unico `ir.access` (odoo/addons/base/models/ir_access.py).
    Os quatro booleanos perm_create/read/write/unlink viraram o campo `operation`,
    uma selection com o subconjunto de "crud" ('crud' = acesso total).
  -->
  <record id="ir_access_whatsapp_template" model="ir.access">
    <field name="name">whatsapp_template</field>
    <field name="model_id" ref="custom_odoo_whatsapp_mass.model_x_whatsapp_template" />
    <field name="group_id" ref="sales_team.group_sale_salesman" />
    <field name="operation">crud</field>
  </record>

  <record id="ir_access_whatsapp_campaing" model="ir.access">
    <field name="name">whatsapp_campaing</field>
    <field name="model_id" ref="custom_odoo_whatsapp_mass.model_x_whatsapp_campaing" />
    <field name="group_id" ref="sales_team.group_sale_salesman" />
    <field name="operation">crud</field>
  </record>
</odoo>
